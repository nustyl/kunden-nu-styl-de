# Supabase (Projekt-Einstellungen -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nur serverseitig verwenden, niemals ins Client-Bundle!
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (S3-kompatibel)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Öffentliche Basis-URL dieses Projekts
NEXT_PUBLIC_SITE_URL=https://kunden.nu-styl.de

# Optional: Resend für E-Mail-Benachrichtigungen (leer lassen = deaktiviert)
RESEND_API_KEY=
RESEND_FROM_EMAIL=NU STYL <benachrichtigung@nu-styl.de>
# Deine E-Mail-Adresse, an die Freigaben/Kommentare gemeldet werden
ADMIN_NOTIFICATION_EMAIL=
